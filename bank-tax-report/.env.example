# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# CODEF (https://codef.io → 로그인 → 키 관리)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
# demo = 개발용(무료, 일 조회 한도 있음) / production = 정식 서비스
CODEF_ENV=demo

# 법인 공동인증서 폴더 (signCert.der, signPri.key 가 들어 있는 폴더)
# 예) C:\Users\홍길동\AppData\LocalLow\NPKI\yessign\USER\cn=(주)회사명...
CERT_DIR=

# 비워 두면 실행할 때마다 물어봅니다(권장)
CERT_PASSWORD=

# 조회할 신한은행 계좌번호(쉼표 구분). 비우면 보유 계좌 전체
SHINHAN_ACCOUNTS=

# 세금계산서 날짜 기준: issued(발급일, 기본) / written(작성일) / transmitted(전송일)
HOMETAX_DATE_BASIS=issued

# 엑셀 저장 폴더 (비우면 이 폴더의 output\)
OUTPUT_DIR=
